{
  "nastroje": [
    {
      "nazev": "Ukázka: vypsat vybrané soubory",
      "skript": "nastroje/ukazka.py",
      "argumenty": ["{soubory}"]
    },
    {
      "nazev": "Úprava exportu CR a DN",
      "skript": "%USERPROFILE%/Skripty/uprav_export_CR_a_DN.py",
      "argumenty": [],
      "zobrazit_slozku": "%USERPROFILE%/Skripty/Deviation_Export/Output"
    },
    {
      "nazev": "Windchill: dotaz na číslo dílu",
      "skript": "%USERPROFILE%/Skripty/windchill/dotaz.py",
      "argumenty": ["{zadat:Číslo dílu (PN)}", "--xlsx", "{cil}/dotaz_vysledek.xlsx"]
    },
    {
      "nazev": "Windchill: aktualizovat index",
      "skript": "%USERPROFILE%/Skripty/windchill/Aktualizovat_index.bat"
    },
    {
      "nazev": "Windchill: přehled PN podle SAP (kontrola)",
      "skript": "%USERPROFILE%/Skripty/windchill/aktualizuj_ze_sap.py",
      "python": "%USERPROFILE%/Skripty/windchill/.venv/Scripts/python.exe",
      "argumenty": ["{soubor}", "{soubor_cil}", "--jen-kontrola"],
      "pripony": [".xlsx"]
    }
  ]
}
